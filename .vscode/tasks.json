{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Repeater",
            "type": "shell",
            "command": "docker run -d --name reactor-repeater -e MESSAGES='<<1000 hello world 1;;<<10 hello world 2;;<<5000 hello world 3' susanhex/repeater:latest || docker restart reactor-repeater"
        },
        {
            "label": "Stop Repeater",
            "type": "shell",
            "command": "docker stop reactor-repeater && docker rm reactor-repeater"
        }
    ]
}